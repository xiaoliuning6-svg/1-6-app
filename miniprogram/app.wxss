/* app.wxss —— 全局样式（骨架版，最小集） */
page {
  background: #f5f5f5;
  font-family: -apple-system, "PingFang SC", sans-serif;
  color: #333;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
}
.muted { color: #999; font-size: 24rpx; }
.title { font-size: 34rpx; font-weight: 600; }
