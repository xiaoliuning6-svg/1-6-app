/* pages/learn/learn.wxss */
/* 底部留出固定翻页条的高度，否则最后一题和「提交」按钮会被压住 */
.page { padding-bottom: 180rpx; }

/* 故事卡 */
.card-head { display: flex; align-items: center; justify-content: space-between; }
.fold { font-size: 24rpx; color: #07c160; }
.story-box { margin-top: 16rpx; }
.story { font-size: 30rpx; line-height: 1.85; color: #333; }
/* 讲解模式：投屏要看得清，字号放大 */
.story-big { font-size: 38rpx; line-height: 2; }
.tip {
  font-size: 26rpx;
  color: #d46b08;
  background: #fff7e6;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  margin-top: 20rpx;
  line-height: 1.6;
}

/* 讲解工具条 */
.teach-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 44rpx 0;
}
.reveal-all { font-size: 24rpx; color: #07c160; }

/* 题目卡 */
.q { padding: 26rpx 24rpx; }
.q-head { display: flex; align-items: center; gap: 10rpx; margin-bottom: 14rpx; }
.q-no {
  width: 40rpx; height: 40rpx; line-height: 40rpx;
  text-align: center; border-radius: 50%;
  background: #07c160; color: #fff;
  font-size: 24rpx;
}
.q-tag {
  font-size: 22rpx;
  color: #07c160;
  background: #f0fff5;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.q-tag.type { color: #666; background: #f2f2f2; }
.q-mark { margin-left: auto; font-size: 32rpx; font-weight: 700; }
.q-mark.ok { color: #07c160; }
.q-mark.no { color: #e54d42; }

.stem { font-size: 30rpx; line-height: 1.7; margin-bottom: 18rpx; color: #222; }

/* 选项 */
.opt {
  padding: 20rpx 24rpx;
  margin: 12rpx 0;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
}
.opt-sel { border-color: #07c160; background: #f0fff5; color: #07c160; }
/* 提交后：正确项绿、选错项红 */
.opt-right { border-color: #07c160; background: #f0fff5; color: #07c160; }
.opt-wrong { border-color: #e54d42; background: #fff1f0; color: #e54d42; }

/* 判断题 */
.judge-row { display: flex; gap: 24rpx; }
.judge-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 30rpx;
}

/* 填空 / 解答 */
.fill {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  background: #fafafa;
  width: 100%;
  box-sizing: border-box;
}
.solve { min-height: 140rpx; line-height: 1.6; }

/* 揭示答案 */
.reveal-btn {
  margin-top: 18rpx;
  text-align: center;
  font-size: 26rpx;
  color: #07c160;
  border: 1rpx dashed #07c160;
  border-radius: 12rpx;
  padding: 16rpx 0;
}
.reveal-btn:active { background: #f0fff5; }

/* 答案与解析 */
.answer {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f7fbff;
  border-left: 6rpx solid #4a90d9;
  border-radius: 8rpx;
}
.answer-line { margin-bottom: 10rpx; }
.answer-label {
  font-size: 22rpx; color: #4a90d9;
  border: 1rpx solid #4a90d9;
  border-radius: 6rpx;
  padding: 0 10rpx;
  margin-right: 12rpx;
}
.answer-text { font-size: 30rpx; font-weight: 600; color: #1a4d80; }
.analysis { font-size: 26rpx; color: #555; line-height: 1.7; }

/* 解答题自评 */
.self-row { margin-top: 18rpx; }
.self-btns { display: flex; gap: 16rpx; margin-top: 12rpx; }
.self-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  color: #666;
}
.self-btn.on { border-color: #07c160; color: #07c160; background: #f0fff5; }
.self-btn.no.on { border-color: #e54d42; color: #e54d42; background: #fff1f0; }

/* 底部 */
.foot { padding: 10rpx 20rpx 40rpx; }
.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.btn-ghost {
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.result { text-align: center; }
.result-big { font-size: 36rpx; font-weight: 600; color: #07c160; }
.result-sub { font-size: 26rpx; color: #666; }
.result-tip { font-size: 24rpx; color: #999; margin: 14rpx 0 24rpx; }

/* ---------- 动画讲解 ---------- */
.anim-card { padding-bottom: 20rpx; }
.anim-sub {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  font-size: 22rpx;
  color: #bbb;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.anim-body { margin-top: 18rpx; }
.anim-canvas {
  width: 100%;
  height: 480rpx;
  background: #fff;
  border: 1rpx solid #eef1ef;
  border-radius: 14rpx;
}
.anim-progress {
  height: 6rpx;
  margin: 18rpx 2rpx 0;
  background: #eef1ef;
  border-radius: 6rpx;
  overflow: hidden;
}
.anim-progress-in {
  height: 100%;
  background: #07c160;
  border-radius: 6rpx;
}
.anim-btns {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}
.anim-btn {
  margin-left: 16rpx;
  padding: 12rpx 40rpx;
  font-size: 26rpx;
  color: #fff;
  background: #07c160;
  border-radius: 999rpx;
}
.anim-btn.ghost {
  color: #07c160;
  background: #fff;
  border: 1rpx solid #07c160;
}

/* 字幕：跟着旁白逐句走。放 canvas 外面而不是画进画布 ——
   这样换字只用 setData，不用重绘整帧，字号也能由 wxss 统一控 */
.anim-subtitle {
  min-height: 68rpx;
  margin-top: 14rpx;
  padding: 0 12rpx;
  font-size: 28rpx;
  line-height: 1.55;
  text-align: center;
  color: #9aa09c;
}
.anim-subtitle.on {
  color: #2b302d;
}
.anim-audio {
  flex: 1;
  font-size: 22rpx;
  color: #c2c7c4;
}

/* ---------- 同册翻页条（固定底部） ---------- */
.pager {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, .98);
  border-top: 1rpx solid #e8ece9;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, .05);
  z-index: 20;
}
.pager-btn {
  padding: 14rpx 34rpx;
  font-size: 27rpx;
  color: #07c160;
  background: #fff;
  border: 1rpx solid #07c160;
  border-radius: 999rpx;
}
/* 册首/册尾：置灰不做点击反馈，让人一眼知道到头了 */
.pager-btn.off {
  color: #c6cbc8;
  background: #fafbfa;
  border-color: #e6eae8;
}
.pager-pos {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 22rpx;
  color: #9aa09c;
  white-space: nowrap;   /* 文案是「第 3 节 · 本单元 2/4」，折行会顶高整条 */
  overflow: hidden;
}
